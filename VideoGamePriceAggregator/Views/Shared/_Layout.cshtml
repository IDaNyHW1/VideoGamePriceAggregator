<!DOCTYPE html>
<html lang="ru">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - GAMEPRICE
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/VideoGamePriceAggregator.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- =========================================
         Верхнее меню
         ========================================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-dark game-navbar">

            <div class="container">

                <!-- Логотип -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Games"
                   asp-action="Index">

                    GAMEPRICE

                </a>


                <!-- Кнопка мобильного меню -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Открыть меню">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Меню -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">


                    <!-- Левая часть меню -->

                    <ul class="navbar-nav">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Games"
                               asp-action="Index">

                                Каталог

                            </a>

                        </li>

                    </ul>


                    <!-- Правая часть меню -->

                    <ul class="navbar-nav">


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <!-- Желаемые игры -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Favorites"
                                   asp-action="Index">

                                    Желаемое

                                </a>

                            </li>


                            <!-- Административные разделы -->
                            @if (User.IsInRole("Admin"))
                            {

                                <!-- Игры -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Games"
                                       asp-action="Index">

                                        Игры

                                    </a>

                                </li>


                                <!-- Магазины -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Stores"
                                       asp-action="Index">

                                        Магазины

                                    </a>

                                </li>


                                <!-- Предложения -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Offers"
                                       asp-action="Index">

                                        Предложения

                                    </a>

                                </li>

                            }


                            <!-- Имя пользователя -->

                            <li class="nav-item">

                                <span class="nav-link user-name">

                                    @User.Identity.Name

                                </span>

                            </li>


                            <!-- Выход -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="logout-form">

                                    <button type="submit"
                                            class="nav-link logout-button">

                                        Выйти

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {

                            <!-- Вход -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Войти

                                </a>

                            </li>


                            <!-- Регистрация -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Регистрация

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


   

    <main class="container py-4">

        @RenderBody()

    </main>


    

    <footer class="game-footer">

        <div class="container">

            <div class="footer-content">


                <div>

                    <strong>
                        GAMEPRICE
                    </strong>

                    <p>
                        Агрегатор цен на видеоигры
                    </p>

                </div>


                <div class="footer-copyright">

                    &copy; 2026 GAMEPRICE

                </div>


            </div>

        </div>

    </footer>


    <!-- =========================================
         JavaScript
         ========================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>