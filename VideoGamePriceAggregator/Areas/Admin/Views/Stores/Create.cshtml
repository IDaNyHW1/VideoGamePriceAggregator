@model VideoGamePriceAggregator.Models.Store

@{
    ViewData["Title"] = "Добавление магазина";
}

<div class="admin-form-page">

    <div class="admin-form-card">

        <div class="admin-form-header">

            <h1>Добавление магазина</h1>

            <p>
                Заполните информацию о магазине.
            </p>

        </div>

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="admin-form-group">

                <label asp-for="Name">
                    Название
                </label>

                <input asp-for="Name"
                       class="game-input"
                       placeholder="Например, Steam" />

                <span asp-validation-for="Name"
                      class="field-validation">
                </span>

            </div>

            <div class="admin-form-group">

                <label asp-for="Website">
                    Сайт
                </label>

                <input asp-for="Website"
                       class="game-input"
                       placeholder="https://example.com" />

                <span asp-validation-for="Website"
                      class="field-validation">
                </span>

            </div>

            <div class="admin-form-group">

                <label asp-for="Country">
                    Страна
                </label>

                <input asp-for="Country"
                       class="game-input"
                       placeholder="International" />

                <span asp-validation-for="Country"
                      class="field-validation">
                </span>

            </div>

            <div class="admin-form-buttons">

                <button type="submit"
                        class="btn-game">
                    Сохранить
                </button>

                <a asp-action="Index"
                   class="admin-cancel">
                    Отмена
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}